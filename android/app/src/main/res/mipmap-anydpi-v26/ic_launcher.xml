<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon. minSdk 26 means every supported device
     resolves through here — no legacy PNG mipmaps needed.
     Phase 08 replaces the artwork; the wiring stays. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_background" />
    <foreground android:drawable="@drawable/launcher_foreground" />
    <monochrome android:drawable="@drawable/launcher_foreground" />
</adaptive-icon>
