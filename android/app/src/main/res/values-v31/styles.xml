<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen APIs: background + animated icon
         (the flame-U vector). values-night-v31 mirrors this with the
         dark launch_bg color. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/launcher_foreground</item>
    </style>

    <style name="NormalTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
