.env*

# On-device model binaries — NEVER in git (loaded via PAD or user import)
/assets/models/
*.gguf
*.task
*.litertlm
*.tflite

# Codegen is banned in v1 (ADR-0003); if it ever appears, ignore it
*.g.dart
*.freezed.dart

# OS junk
.DS_Store
Thumbs.db
__pycache__/
